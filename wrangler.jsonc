{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-online",
  "compatibility_date": "2026-06-10",
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "markdownonline.app",
      "custom_domain": true
    }
  ]
}
